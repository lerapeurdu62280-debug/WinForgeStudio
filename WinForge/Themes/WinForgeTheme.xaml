<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WFBackgroundBrush" Color="#171717" />
    <SolidColorBrush x:Key="WFPanelBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="WFCardBrush" Color="#232323" />
    <SolidColorBrush x:Key="WFCard2Brush" Color="#262626" />
    <SolidColorBrush x:Key="WFBorderBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="WFAccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="WFAccent2Brush" Color="#16A34A" />
    <SolidColorBrush x:Key="WFTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="WFMutedBrush" Color="#9CA3AF" />
    <SolidColorBrush x:Key="WFMuted2Brush" Color="#7B7B7B" />
    <SolidColorBrush x:Key="WFWarningBrush" Color="#F59E0B" />

    <Style x:Key="WFNavButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource WFCardBrush}" />
        <Setter Property="Foreground" Value="{StaticResource WFTextBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="WFPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource WFAccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource WFTextBrush}" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style x:Key="WFCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WFCardBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12" />
    </Style>
</ResourceDictionary>
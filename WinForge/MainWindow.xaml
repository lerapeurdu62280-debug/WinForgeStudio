<Window
    x:Class="WinForge.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="WinForge Studio">

    <Grid Background="{StaticResource WFBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="22"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="3" Background="{StaticResource WFPanelBrush}" BorderBrush="{StaticResource WFBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Padding="12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="🛠️" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="WinForge Studio" Foreground="{StaticResource WFTextBrush}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ProjectNameLabel" Text="— S.O.S INFO LUDO" Foreground="{StaticResource WFMuted2Brush}" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="BtnOpenISO" Content="📂 Ouvrir ISO" Style="{StaticResource WFPrimaryButtonStyle}" Click="BtnOpenISO_Click"/>
                    <Button x:Name="BtnSaveProfile" Content="💾 Sauver profil" Background="{StaticResource WFCardBrush}" Foreground="{StaticResource WFTextBrush}" Padding="12,8" Click="BtnSaveProfile_Click"/>
                    <Button x:Name="BtnLoadProfile" Content="📂 Charger profil" Background="{StaticResource WFCardBrush}" Foreground="{StaticResource WFTextBrush}" Padding="12,8" Click="BtnLoadProfile_Click"/>
                    <Button x:Name="BtnGoBuild" Content="⚙ Construire" Background="{StaticResource WFCardBrush}" Foreground="{StaticResource WFTextBrush}" Padding="12,8" Click="BtnGoBuild_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource WFPanelBrush}" BorderBrush="{StaticResource WFBorderBrush}" BorderThickness="0,0,1,0">
            <Grid Padding="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="SOURCE ISO" Foreground="{StaticResource WFMuted2Brush}" FontSize="11" Margin="0,0,0,8"/>

                <Border Grid.Row="1" Style="{StaticResource WFCardBorderStyle}" Margin="0,0,0,16">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="IsoNameLabel" Text="Aucune ISO chargée" Foreground="{StaticResource WFTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="IsoVersionLabel" Text="Version : —" Foreground="{StaticResource WFMutedBrush}" FontSize="11"/>
                        <TextBlock x:Name="IsoSizeLabel" Text="Taille : —" Foreground="{StaticResource WFMutedBrush}" FontSize="11"/>
                        <ComboBox x:Name="EditionComboBox" Header="Édition Windows" Width="260" IsEnabled="False" SelectionChanged="EditionComboBox_SelectionChanged" DisplayMemberPath="Name"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2" Spacing="6">
                    <TextBlock Text="MODULES" Foreground="{StaticResource WFMuted2Brush}" FontSize="11" Margin="0,0,0,6"/>
                    <Button x:Name="NavDebloat" Content="🧹 Debloating" Style="{StaticResource WFNavButtonStyle}" Click="NavDebloat_Click"/>
                    <Button x:Name="NavOptim" Content="⚡ Optimisation" Style="{StaticResource WFNavButtonStyle}" Click="NavOptim_Click"/>
                    <Button x:Name="NavInject" Content="💉 Injection" Style="{StaticResource WFNavButtonStyle}" Click="NavInject_Click"/>
                    <Button x:Name="NavUnattend" Content="📄 Autounattend" Style="{StaticResource WFNavButtonStyle}" Click="NavUnattend_Click"/>
                    <Button x:Name="NavBuild" Content="📦 Export ISO" Style="{StaticResource WFNavButtonStyle}" Click="NavBuild_Click"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Spacing="6">
                    <TextBlock Text="PROFIL ACTIF" Foreground="{StaticResource WFMuted2Brush}" FontSize="11"/>
                    <ComboBox x:Name="ProfileSelector" PlaceholderText="Aucun profil chargé"/>
                </StackPanel>
            </Grid>
        </Border>

        <Frame x:Name="ModuleFrame" Grid.Row="1" Grid.Column="1"/>

        <Border Grid.Row="1" Grid.Column="2" Background="{StaticResource WFPanelBrush}" BorderBrush="{StaticResource WFBorderBrush}" BorderThickness="1,0,0,0">
            <ScrollViewer>
                <StackPanel Padding="10" Spacing="10">
                    <TextBlock Text="APERÇU" Foreground="{StaticResource WFMuted2Brush}" FontSize="11"/>
                    <TextBlock x:Name="EstimatedSizeLabel" Text="Taille estimée : —" Foreground="{StaticResource WFTextBrush}"/>
                    <TextBlock x:Name="SelectionCountLabel" Text="0 élément sélectionné" Foreground="{StaticResource WFMutedBrush}"/>

                    <TextBlock Text="PROGRESSION" Foreground="{StaticResource WFMuted2Brush}" FontSize="11" Margin="0,8,0,0"/>
                    <TextBlock Text="Debloat" Foreground="{StaticResource WFMutedBrush}"/>
                    <ProgressBar x:Name="DebloatProgress" Minimum="0" Maximum="100"/>
                    <TextBlock Text="Injection" Foreground="{StaticResource WFMutedBrush}"/>
                    <ProgressBar x:Name="InjectProgress" Minimum="0" Maximum="100"/>
                    <TextBlock Text="Mises à jour" Foreground="{StaticResource WFMutedBrush}"/>
                    <ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="100"/>

                    <TextBlock Text="OPTIONS GLOBALES" Foreground="{StaticResource WFMuted2Brush}" FontSize="11" Margin="0,8,0,0"/>
                    <ToggleSwitch x:Name="GlobalTelemetryToggle" Header="Télémétrie" Toggled="GlobalOptimToggle_Toggled"/>
                    <ToggleSwitch x:Name="GlobalCortanaToggle" Header="Cortana" Toggled="GlobalOptimToggle_Toggled"/>
                    <ToggleSwitch x:Name="GlobalServicesToggle" Header="Services" Toggled="GlobalOptimToggle_Toggled"/>
                    <ToggleSwitch x:Name="GlobalPerfToggle" Header="Performance" Toggled="GlobalOptimToggle_Toggled"/>

                    <TextBlock Text="JOURNAL" Foreground="{StaticResource WFMuted2Brush}" FontSize="11" Margin="0,8,0,0"/>
                    <TextBox x:Name="LogText" Height="260" AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="True"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="3" Background="{StaticResource WFAccentBrush}">
            <Grid Padding="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusLabel" Text="Prêt" Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="WinForge Studio" Foreground="White" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
<Page
    x:Class="WinForge.Views.EditionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="20">
        <StackPanel Spacing="16" MaxWidth="560" HorizontalAlignment="Left">

            <StackPanel Spacing="4">
                <TextBlock Text="ISO source" Foreground="{StaticResource WFTextBrush}" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Charge l'ISO Windows à personnaliser et choisis l'édition à construire."
                           Foreground="{StaticResource WFMuted2Brush}" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>

            <Button x:Name="BtnOpenISO" Content="📂 Ouvrir une ISO" Style="{StaticResource WFPrimaryButtonStyle}" Click="BtnOpenISO_Click" HorizontalAlignment="Left"/>

            <StackPanel Spacing="4">
                <TextBlock x:Name="IsoNameLabel" Text="Aucune ISO chargée" Foreground="{StaticResource WFTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock x:Name="IsoVersionLabel" Text="Version : —" Foreground="{StaticResource WFMutedBrush}" FontSize="12"/>
                <TextBlock x:Name="IsoSizeLabel" Text="Taille : —" Foreground="{StaticResource WFMutedBrush}" FontSize="12"/>
            </StackPanel>

            <ComboBox x:Name="EditionComboBox" Header="Édition Windows" Width="320" IsEnabled="False"
                      SelectionChanged="EditionComboBox_SelectionChanged" DisplayMemberPath="Name" HorizontalAlignment="Left"/>

        </StackPanel>
    </ScrollViewer>
</Page>

<Page
    x:Class="WinForge.Views.OptimisationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="16">
        <StackPanel Spacing="10">
            <TextBlock Text="Options d'optimisation" Foreground="{StaticResource WFTextBrush}" FontSize="16" FontWeight="SemiBold"/>

            <ToggleSwitch x:Name="ToggleTelemetry" Header="Désactiver télémétrie" Toggled="Toggle_Toggled"/>
            <ToggleSwitch x:Name="ToggleCortana" Header="Désactiver Cortana" Toggled="Toggle_Toggled"/>
            <ToggleSwitch x:Name="ToggleServices" Header="Optimiser les services" Toggled="Toggle_Toggled"/>
            <ToggleSwitch x:Name="TogglePerf" Header="Mode performance" Toggled="Toggle_Toggled"/>
        </StackPanel>
    </ScrollViewer>
</Page>
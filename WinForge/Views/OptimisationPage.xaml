<Page
    x:Class="WinForge.Views.OptimisationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <Style x:Key="OptHintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource WFMutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,-6,0,8"/>
        </Style>
    </Page.Resources>

    <ScrollViewer Padding="16">
        <StackPanel Spacing="10">
            <TextBlock Text="Options d'optimisation" Foreground="{StaticResource WFTextBrush}" FontSize="16" FontWeight="SemiBold"/>

            <TextBlock Text="Seul endroit où se règlent la télémétrie et les services : appliqué directement dans le registre de l'image." Foreground="{StaticResource WFMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/>

            <ToggleSwitch x:Name="ToggleTelemetry" Header="Désactiver télémétrie" Toggled="Toggle_Toggled"/>
            <TextBlock Text="AllowTelemetry = 0, services DiagTrack et dmwappushservice désactivés, publicité ciblée coupée." Style="{StaticResource OptHintStyle}"/>
            <ToggleSwitch x:Name="ToggleCortana" Header="Désactiver Cortana" Toggled="Toggle_Toggled"/>
            <TextBlock Text="Cortana et la recherche web Bing dans le menu Démarrer coupées par stratégie (l'appli Cortana se retire dans Debloat)." Style="{StaticResource OptHintStyle}"/>
            <ToggleSwitch x:Name="ToggleServices" Header="Optimiser les services" Toggled="Toggle_Toggled"/>
            <TextBlock Text="Désactivés : DiagTrack, dmwappushservice, MapsBroker, RetailDemo, RemoteRegistry, WerSvc (rapport d'erreurs), WSearch (indexation). En manuel : SysMain, Spooler (impression)." Style="{StaticResource OptHintStyle}"/>
            <ToggleSwitch x:Name="TogglePerf" Header="Mode performance" Toggled="Toggle_Toggled"/>
            <TextBlock Text="Effets visuels réduits, transparence et animations coupées, priorité au premier plan, veille prolongée désactivée." Style="{StaticResource OptHintStyle}"/>
        </StackPanel>
    </ScrollViewer>
</Page>
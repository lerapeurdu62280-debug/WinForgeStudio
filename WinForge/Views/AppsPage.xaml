<Page
    x:Class="WinForge.Views.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WinForge.Models">

    <ScrollViewer Padding="16">
        <StackPanel Spacing="16">

            <StackPanel Spacing="4">
                <TextBlock Text="Applications au premier démarrage" Foreground="{StaticResource WFTextBrush}" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Copiées dans l'ISO et proposées par WinForge Assistant au premier démarrage (catalogue de logiciels courants disponible directement dans l'assistant)."
                           Foreground="{StaticResource WFMuted2Brush}" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Text="Vos propres .exe/.msi (ex. outils tiers) : copiés dans l'ISO et proposés par WinForge Assistant."
                           Foreground="{StaticResource WFMuted2Brush}" FontSize="12" TextWrapping="Wrap"/>

                <ListView x:Name="CustomAppsList" Height="200" SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:AppInstallEntry">
                            <Grid Padding="4,7" ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{x:Bind Name}" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind InstallerPath}" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource WFMuted2Brush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="BtnAddCustomApp" Content="➕ Ajouter un installeur..." Click="BtnAddCustomApp_Click"/>
                    <Button x:Name="BtnRemoveCustomApp" Content="🗑️ Retirer la sélection" Click="BtnRemoveCustomApp_Click"/>
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>

<Page
    x:Class="WinForge.Views.InjectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="BtnAddDriver" Content="➕ Ajouter driver" Click="BtnAddDriver_Click"/>
            <Button x:Name="BtnAddUpdate" Content="➕ Ajouter MAJ" Click="BtnAddUpdate_Click"/>
        </StackPanel>

        <ListView x:Name="InjectionList" Grid.Row="1" Margin="0,12,0,0" Background="{StaticResource WFCardBrush}"/>
    </Grid>
</Page>